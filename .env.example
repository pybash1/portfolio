# Server-only Authentik credentials.
AUTHENTIK_ISSUER=https://auth.example.com/application/o/<app-slug>/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# A separate random secret of at least 32 characters: openssl rand -hex 32
INSPO_SESSION_SECRET=
INSPO_SITE_URL=https://example.com
INSPO_OWNER_USERNAME=
# Optional: pin the immutable OIDC subject instead of matching the username.
# INSPO_OWNER_SUB=

# Runtime account: DML only, no database or schema creation privileges.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=verify-full&sslrootcert=system
# Server-only S3-compatible storage for screenshots, images, and font files.
S3_ENDPOINT=https://s3.example.com
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public bucket/CDN root. Without it, /api/inspo/assets serves files.
S3_PUBLIC_BASE_URL=https://cdn.example.com/
# Keep the privileged DATABASE_MIGRATION_URL only in ignored .env.migrations.local,
# never in the deployed application's environment.
