---
import Layout from "../layouts/Layout.astro";
import { projects } from "../lib/utils";

const categoryOrder = ["active", "shipped", "roles", "abandoned"];

const grouped = categoryOrder.reduce<Record<string, typeof projects>>((acc, category) => {
  const items = projects.filter((p) => p.status === category);
  if (items.length > 0) acc[category] = items;
  return acc;
}, {});

const totalProjects = projects.length.toString().padStart(2, "0");
---

<Layout title="Projects — Ananjan Mitra">
  <main class="min-h-screen bg-bg text-primary">
    <header class="fixed left-0 top-0 z-50 w-full border-b border-white/[0.06] bg-bg/75 px-4 py-4 backdrop-blur-sm md:px-8">
      <nav class="grid grid-cols-2 items-center font-mono text-[11px] uppercase tracking-[0.14em] text-white">
        <a href="/" class="group text-white/65 transition-colors duration-300 hover:text-white">
          <span class="text-accent">&lt;</span>
          <span class="ml-1">Ananjan Mitra</span>
          <span class="ml-1 inline-block transition-transform duration-300 group-hover:-translate-x-0.5">/home</span>
        </a>
        <div class="text-right text-[10px] text-white/30">&copy; 2026</div>
      </nav>
    </header>

    <section class="px-4 pb-12 pt-[5.5rem] md:px-8 md:pb-16 md:pt-[6.5rem]">
      <div class="mx-auto max-w-[1400px]">
        <div class="grid gap-8 border-b border-white/[0.08] pb-10 md:grid-cols-[minmax(0,1fr)_16rem] md:items-end md:gap-10">
          <div>
            <h1 class="font-mono text-[clamp(2.5rem,4.8vw,4.5rem)] uppercase leading-[0.95] tracking-normal text-white">
              Projects<span class="text-accent">.</span>
            </h1>
          </div>

          <div class="border border-white/[0.1] bg-white/[0.02] p-4 font-mono">
            <div class="mb-3 flex items-center justify-between border-b border-white/[0.08] pb-2 text-[9px] uppercase tracking-[0.22em]">
              <span class="text-accent">index</span>
              <span class="text-white/35">{totalProjects} rows</span>
            </div>
            <p class="text-[11px] leading-[2] text-white/62">
              Built, shipped, paused, abandoned, or just kept around because the idea still has a pulse.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="px-4 pb-28 md:px-8 md:pb-36">
      <div class="mx-auto max-w-[1400px]">
        <div class="flex flex-col gap-12 md:gap-16">
          {Object.entries(grouped).map(([status, items], groupIndex) => (
            <section class="grid grid-cols-1 gap-5 md:grid-cols-12 md:gap-8">
              <div class="md:col-span-3">
                <div class="sticky top-28 border-l border-accent/40 pl-4">
                  <div class="text-[9px] uppercase tracking-[0.3em] text-accent">
                    [{(groupIndex + 1).toString().padStart(2, "0")}] {status}
                  </div>
                  <div class="mt-2 text-[10px] uppercase tracking-[0.2em] text-white/30">
                    {items.length.toString().padStart(2, "0")} entries
                  </div>
                </div>
              </div>

              <div class="md:col-span-9">
                <div class="border border-white/[0.1]">
                  <div class="grid grid-cols-[3.5rem_minmax(0,1fr)_auto] border-b border-white/[0.08] bg-white/[0.03] px-3 py-2 text-[9px] uppercase tracking-[0.2em] text-white/35 md:grid-cols-[4.5rem_minmax(0,0.7fr)_minmax(12rem,1fr)_auto] md:px-4">
                    <span>id</span>
                    <span>name</span>
                    <span class="hidden md:block">note</span>
                    <span class="text-right">out</span>
                  </div>

                  {items.map((project, i) => (
                    <div class="grid grid-cols-[3.5rem_minmax(0,1fr)_auto] items-start gap-3 border-b border-white/[0.06] px-3 py-4 font-mono transition-colors duration-200 last:border-b-0 hover:bg-white/[0.025] md:grid-cols-[4.5rem_minmax(0,0.7fr)_minmax(12rem,1fr)_auto] md:px-4">
                      <span class="pt-0.5 text-[10px] text-white/30">
                        {(i + 1).toString().padStart(2, "0")}
                      </span>
                      <div>
                        <h2 class="text-[12px] uppercase tracking-[0.12em] text-white md:text-[13px]">{project.name}</h2>
                        <p class="mt-2 text-[10px] leading-[1.8] text-white/45 md:hidden">{project.description}</p>
                      </div>
                      <p class="hidden text-[11px] leading-[1.8] text-white/52 md:block">{project.description}</p>
                      {project.link ? (
                        <a
                          href={project.link}
                          target={project.link.startsWith("https://") ? "_blank" : undefined}
                          rel={project.link.startsWith("https://") ? "noreferrer" : undefined}
                          class="group inline-flex items-center gap-2 pt-0.5 text-[9px] uppercase tracking-[0.22em] text-white/45 transition-colors duration-300 hover:text-white"
                        >
                          <span>open</span>
                          <span class="inline-block text-accent/65 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
                        </a>
                      ) : (
                        <span class="pt-0.5 text-right text-[9px] uppercase tracking-[0.22em] text-white/20">--</span>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>
