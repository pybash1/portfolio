---
import Layout from "../layouts/Layout.astro";
import Folder from "../components/desk/Folder.astro";
import Dossier from "../components/desk/Dossier.astro";
import Document from "../components/desk/Document.astro";
import Photo from "../components/desk/Photo.astro";
import Map from "../components/desk/Map.astro";
import BusinessCard from "../components/desk/BusinessCard.astro";
import NewsClipping from "../components/desk/NewsClipping.astro";
import Ticket from "../components/desk/Ticket.astro";
import MetalClip from "../components/desk/MetalClip.astro";
import FridgeMagnet from "../components/desk/FridgeMagnet.astro";
import Pen from "../components/desk/Pen.astro";
import Breadboard from "../components/desk/Breadboard.astro";
import JumperWires from "../components/desk/JumperWires.astro";
import Stamp from "../components/desk/Stamp.astro";
import DeskCanvas from "../components/desk/DeskCanvas.astro";
import Movable from "../components/desk/Movable.astro";
---

<Layout title="Portfolio — Ananjan Mitra">
  <DeskCanvas
    storageKey="portfolio"
    label="Portfolio collection"
    class="m-0 grid w-full grid-cols-1 justify-items-center gap-16 overflow-clip p-0 sm:grid-cols-2 sm:items-center lg:block lg:h-370 lg:overflow-visible"
  >
    <Movable
      id="work-folder"
      label="Selected work folder"
      class="z-10 w-full max-w-170 sm:col-span-2 lg:absolute lg:left-[30%] lg:top-9 lg:w-[53%] lg:-rotate-3"
    >
      <Folder
        title="Selected work"
        subtitle="Public Works Department"
        label="Personal archive"
        referenceNo="AM/008–026"
        startDate="25/03/2008"
        photo={{
          src: "/photos/bengaluru-lake.webp",
          alt: "A lakeside at dusk, lights coming on along the far shore",
          caption: "15 / 03 / 2025",
        }}
        pocket={{ label: "Field notes" }}
        projects={[
          {
            name: "Curius",
            category: "A place for curious minds",
            year: "2026",
            href: "https://github.com/pybash1",
          },
          {
            name: "Provoke",
            category: "Following the good rabbit holes",
            year: "2026",
            href: "https://github.com/pybash1/provoke",
          },
          {
            name: "Harvence",
            category: "A little more intentional living",
            year: "2024",
            href: "https://harvence.pybash.xyz",
          },
        ]}
      />
    </Movable>

    <Movable
      id="dossier"
      label="About Ananjan"
      class="z-20 w-full max-w-68.75 -rotate-4 lg:absolute lg:left-[5%] lg:top-80 lg:w-[25%] lg:max-w-none"
    >
      <Dossier
        title={"The person\nbehind the papers."}
        reference="Subject / AM–001"
        role="Builder, engineer, curious person."
        text="I like making things, taking them apart, and figuring out what could be better. Some work. Some don't. I keep going."
        annotation="still figuring it out"
      />
      <MetalClip
        id="dossier-triangle"
        kind="paperclip"
        shape="triangle"
        color="steel"
        class="absolute -bottom-4.75 left-[18%] z-40 w-12 rotate-180"
      />
    </Movable>

    <Movable
      id="field-guide"
      label="A business card"
      class="z-20 w-[107px] rotate-5 lg:absolute lg:right-[8%] lg:top-97.5"
    >
      <BusinessCard
        house="pybash"
        name="Ananjan Mitra"
        role="Builder, engineer, curious person."
        details={["pybash.xyz · github.com/pybash1", "hi@pybash.xyz"]}
      />
    </Movable>

    <Movable
      id="india-map"
      label="India field atlas"
      class="z-20 w-full max-w-105 rotate-[-7deg] lg:absolute lg:left-[31%] lg:top-147.5 lg:w-[32%]"
    >
      <Map
        cities={[
          "Kolkata",
          "Ooty",
          "Kochi",
          "New Delhi",
          "Dharamshala",
          "Bangalore",
          "Port Blair",
          "Bhubaneshwar",
        ]}
        xCities={[
          "Mumbai",
          "Vishakhapatnam",
          "Chennai",
          "Darjeeling",
          "Shillong",
          "Pune",
          "Jaipur",
          "Goa",
          "Itanagar",
        ]}
        title="India — a personal field atlas"
        caption="A few places to return to."
        backNote="Keep following the detours."
        backReference="AM / INDIA / FIELD COLLECTION"
      />
    </Movable>

    <Movable
      id="mountain-photo"
      label="A photograph of a Durga Puja pandal in Kolkata"
      class="z-10 w-60 rotate-6 lg:absolute lg:left-[12%] lg:top-190 lg:w-[27%]"
    >
      <Photo
        src="/photos/kolkata-pandal.webp"
        alt="A Durga Puja pandal at night: giant carved serpents lit red, the goddess below"
        date="Kolkata, October 2026"
        blue
        edges="worn"
      />
    </Movable>

    <Movable
      id="letter"
      label="Personal correspondence"
      class="z-10 w-full max-w-87.5 rotate-3 lg:absolute lg:left-[66%] lg:top-236.25 lg:w-[26%]"
    >
      <Document
        title="A note to whoever finds this"
        signature="Ananjan"
        postscript="P.S. There's always something else in the works."
        paragraphs={[
          "I've never been very good at fitting everything into a neat little introduction.",
          "So here's a collection instead. Things I've built, places I've wandered, and ideas that haven't quite left me alone.",
          "Have a look around. If something catches your eye, I'd love to hear from you.",
        ]}
      />
      <Stamp
        text="Open to part-time remote work"
        color="#2f7a3a"
        angle={-4}
        class="absolute bottom-[2.5%] right-[4%] z-30 whitespace-nowrap"
      />
      <FridgeMagnet class="absolute -bottom-3 left-[9%] z-40 w-11 -rotate-24" />
    </Movable>

    <Movable
      id="forest-photo"
      label="A photograph of a temple in Bengaluru"
      class="z-20 w-46.25 -rotate-6 lg:absolute lg:left-[67%] lg:top-110 lg:w-[16%]"
    >
      <Photo
        src="/photos/bengaluru-temple.webp"
        alt="A white temple tower rising over a grey stone wall and a trimmed hedge, under a clear blue sky"
        date="Bengaluru, March 2025"
      />
    </Movable>

    <Movable
      id="ticket"
      label="An invitation to get in touch"
      class="z-30 w-full max-w-77.5 -rotate-6 sm:col-span-2 lg:absolute lg:left-[32%] lg:top-296.25 lg:w-[29%] lg:max-w-none"
    >
      <Ticket
        title="One good conversation"
        subtitle="Admit two curious people"
        serial="NO. 002621"
        footer="No expiry. No particular agenda."
      />
      <FridgeMagnet class="absolute -top-3 left-[16%] z-40 w-11 rotate-18" />
    </Movable>

    <Movable
      id="news-clipping"
      label="A newspaper cutting"
      class="z-20 w-full max-w-72 rotate-4 lg:absolute lg:left-[70%] lg:top-160 lg:w-[19%] lg:max-w-none"
    >
      <NewsClipping
        headline={["Read.cv features", "Local dev"]}
        byline="A special correspondent"
        paragraphs={[
          "Residents were surprised on Tuesday when a quiet tinkerer announced that the project, long thought abandoned, was in fact still being worked on, mostly in the evenings and occasionally at dawn.",
          "Asked why, he shrugged. It seemed like a good idea at the time, he said, and it still does, more or less.",
          "Those who have seen it describe a small, stubborn machine that does one thing and does it well enough.",
          "Neighbours report lights burning late in the workshop, the smell of solder, and now and then a cheerful, muffled shout when something finally works.",
          "The council has been informed, though it has not yet replied. A spokesman said only that the matter was being looked into, and that nobody had asked for any of this.",
          "He expects to keep going. There is, he says, always something else in the works.",
        ]}
        caption="Local Developer"
      />
    </Movable>

    <Movable
      id="black-pen"
      label="A black gel pen. Press Enter to click it."
      class="z-30 w-80.5 lg:absolute lg:left-[40%] lg:top-265"
    >
      <Pen id="pen-black" color="black" angle={-14} />
    </Movable>
    <Movable
      id="breadboard"
      label="A solderless breadboard."
      class="z-30 w-91.5 lg:absolute lg:left-[5%] lg:top-322.5"
    >
      <Breadboard id="breadboard-board" angle={-4} />
    </Movable>
    <JumperWires />
    <Movable
      id="blue-pen"
      label="A blue gel pen. Press Enter to click it."
      class="z-30 w-80.5 lg:absolute lg:left-[62%] lg:top-82.5"
    >
      <Pen id="pen-blue" color="blue" angle={24} />
    </Movable>

    <MetalClip
      id="loose-gem"
      kind="paperclip"
      color="yellow"
      mounted={false}
      class="absolute left-[8%] top-167.5 hidden w-11 -rotate-12 lg:block"
    />
    <MetalClip
      id="loose-triangle"
      kind="paperclip"
      shape="triangle"
      color="steel"
      mounted={false}
      class="absolute left-[14%] top-27.5 hidden w-11 rotate-28 lg:block"
    />
  </DeskCanvas>
</Layout>
