---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader";
import AsciiCascade from "../components/AsciiCascade";
import WaveReveal from "../components/WaveReveal";

const rssResponse = await fetch("https://journal.pybash.xyz/rss.xml");
const rssText = await rssResponse.text();
const articleMatches = [...rssText.matchAll(/<item>([\s\S]*?)<\/item>/g)];
const allArticles = articleMatches.map(match => {
  const content = match[1];
  const title = content?.match(/<title>([\s\S]*?)<\/title>/)?.[1] || "";
  const link = content?.match(/<link>([\s\S]*?)<\/link>/)?.[1]?.replace("/blog/", "/writing/") || "";
  const pubDate = content?.match(/<pubDate>([\s\S]*?)<\/pubDate>/)?.[1] || "";
  const cleanTitle = title
    .replace(/&apos;/g, "'").replace(/&quot;/g, '"')
    .replace(/&amp;/g, "&").replace(/&gt;/g, ">").replace(/&lt;/g, "<")
    .replace(/&#(\d+);/g, (_, n) => String.fromCharCode(Number(n)))
    .replace(/&minus;/g, "−");
  return {
    title: cleanTitle,
    link,
    date: new Date(pubDate),
    displayDate: new Date(pubDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  };
}).sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 5);

const projects = [
  {
    num: "01",
    name: "HARVENCE",
    stack: "React Native",
    year: "2024",
    status: "Live",
    description: "Eat healthier without thinking about it. Calorie tracking and instant barcode scanning for nutritional info before you even buy it.",
    link: "https://harvence.pybash.xyz",
    linkText: "View Project",
  },
  {
    num: "02",
    name: "PROVOKE",
    stack: "Python / Redis",
    year: "2026",
    status: "In Dev",
    description: "A search engine built exclusively for great writing. Asynchronous large-scale web crawling with a trained content classifier. A small language model is next.",
    link: "https://github.com/pybash1/provoke",
    linkText: "View on GitHub",
  },
  {
    num: "03",
    name: "CURIUS",
    stack: "Astro / Go",
    year: "2026",
    status: "Soon",
    description: "An open source alternative to Curius. Built to simplify peer-based reading habits and encourage going down the right rabbit holes.",
    link: undefined,
    linkText: undefined,
  },
];

const principles = [
  "Loading screens are cheating.",
  "If it needs explanation, it's bad design.",
  "Build what you'd use.",
  "Precision before speed.",
  "Make it, then make it better.",
];
---

<Layout title="Portfolio — Ananjan Mitra">
  <main class="relative">
<SiteHeader client:load />

    <!-- ─── HERO ─────────────────────────────────────────────────────── -->
    <section class="min-h-screen md:h-screen grid grid-cols-1 md:grid-cols-[minmax(280px,0.78fr)_minmax(0,1.22fr)] px-4 md:px-8 pt-20 pb-10 relative z-10 overflow-hidden gap-8 md:gap-14">

      <div class="relative z-10 flex h-auto md:h-full min-h-0 flex-col justify-center md:justify-end pb-2 md:pb-24 max-w-[520px]">
        <div class="font-mono text-[9px] uppercase tracking-[0.32em] text-accent mb-5">~/identity</div>
        <h1 class="font-mono uppercase text-white leading-[0.9] tracking-tight text-[clamp(2.7rem,7vw,6.4rem)]">
          Ananjan<br />
          <span class="text-accent">Mitra</span>
        </h1>
        <p class="mt-7 max-w-[420px] font-mono text-[11px] md:text-xs leading-[2.1] text-white/65">
          Builder from Kolkata working across apps, systems, search, and interface experiments.
          I care about fast software, strange taste, and making the thing real before explaining it.
        </p>
        <div class="mt-8 grid grid-cols-[auto_1fr] gap-x-5 gap-y-2.5 font-mono text-[9px] uppercase tracking-[0.2em]">
          <span class="text-white/35">loc</span>
          <span class="text-white/70">Kolkata, India</span>
          <span class="text-white/35">mode</span>
          <span class="text-white/70">building in public, mostly quietly</span>
        </div>
      </div>

      <div class="relative min-h-0 h-[42vh] md:h-full">
        <AsciiCascade client:load />
      </div>

      <div class="absolute bottom-8 left-4 right-4 md:left-8 md:right-8 flex justify-between items-end pointer-events-none">
        <div class="font-mono text-[9px] uppercase tracking-[0.3em] text-white/25">Scroll ↓</div>
        <div class="font-mono text-[9px] text-white/20 tracking-[0.12em] hidden md:block">v2026.06 · pybash.xyz</div>
      </div>
    </section>

    <!-- ─── WORK ──────────────────────────────────────────────────────── -->
    <section class="py-14 md:py-20 relative z-10 px-4 md:px-8 border-t border-white/[0.08]">
      <div class="max-w-[1400px] mx-auto">
        <div class="flex items-center gap-4 mb-8 md:mb-12">
          <span class="font-mono text-[9px] text-accent tracking-[0.3em] uppercase">/* 01 work */</span>
          <div class="flex-1 h-px bg-white/[0.1]"></div>
        </div>
        <div class="flex flex-col gap-2">
          {projects.map((project) => (
            <div
              class="project-window font-mono border border-white/[0.12] hover:border-white/[0.28] transition-colors duration-500"
              style="opacity: 0; transform: translateY(18px);"
            >
              <div class="flex items-center justify-between px-4 md:px-5 py-2.5 border-b border-white/[0.08] bg-white/[0.03]">
                <div class="flex items-center gap-3">
                  <span class="text-white/35 text-[9px]">[{project.num}]</span>
                  <span class="text-[11px] md:text-[13px] tracking-[0.1em] text-white">{project.name}</span>
                  <span class="text-[9px] text-white/40 tracking-widest hidden md:inline">— {project.stack}</span>
                </div>
                <div class="flex items-center gap-4">
                  <span class={`text-[9px] tracking-widest uppercase ${project.status === 'Live' ? 'text-accent' : 'text-white/45'}`}>
                    {project.status}
                  </span>
                  <span class="text-white/35 text-[9px] hidden md:inline">{project.year}</span>
                </div>
              </div>
              <div class="px-4 md:px-5 py-4 grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_10rem] gap-4 md:gap-8 md:items-center">
                <p class="text-[11px] leading-[2] text-white/62 max-w-[620px]">{project.description}</p>
                <div class="md:justify-self-end md:self-center">
                  {project.link ? (
                    <a
                      href={project.link}
                      target="_blank"
                      rel="noreferrer"
                      class="group inline-flex h-8 items-center justify-end gap-2 text-[9px] uppercase tracking-[0.22em] text-white/50 hover:text-white/90 transition-colors duration-300"
                    >
                      <span>{project.linkText}</span>
                      <svg viewBox="0 0 24 24" class="w-3 h-3 text-white/35 transition-all duration-300 group-hover:text-accent group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M7 17L17 7M17 7H7M17 7V17" />
                      </svg>
                    </a>
                  ) : (
                    <span class="inline-flex h-8 items-center text-[9px] uppercase tracking-[0.22em] text-white/30">Coming Soon</span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── PHILOSOPHY ────────────────────────────────────────────────── -->
    <section class="py-20 md:py-32 relative z-10 px-4 md:px-8 border-t border-white/[0.08]">
      <div class="max-w-[1400px] mx-auto">
        <div class="flex items-center gap-4 mb-12 md:mb-20">
          <span class="font-mono text-[9px] text-accent tracking-[0.3em] uppercase">/* 02 philosophy */</span>
          <div class="flex-1 h-px bg-white/[0.1]"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-14 md:gap-24 items-start">
          <!-- Statement + bio -->
          <div>
            <h2 class="font-mono uppercase leading-[0.88] tracking-tight overflow-hidden">
              <span class="block text-white" style="font-size: clamp(2.5rem, 5.5vw, 5.5rem);">
                <WaveReveal text="BUILDER" client:visible />
              </span>
              <span class="block text-accent" style="font-size: clamp(2.5rem, 5.5vw, 5.5rem);">
                <WaveReveal text="OR NOTHING." delay={0.12} client:visible />
              </span>
            </h2>
            <p class="font-mono text-[11px] leading-[2.3] text-white/60 mt-10 max-w-[360px]">
              A builder who'd rather make something than talk about it.
              Comfortable with failure as long as I'm in the process of making.
              Ambitious but self-aware enough to laugh at my own ambition.
            </p>
          </div>

          <!-- Principles list -->
          <div class="font-mono text-[10px] md:text-[11px] uppercase tracking-[0.08em] text-white/50 border-t border-white/[0.1] pt-6 md:pt-10 flex flex-col gap-0.5">
            {principles.map((p, i) => (
              <div class="flex gap-4 py-1.5 group hover:text-white/85 transition-colors duration-200 cursor-default leading-[1.7]">
                <span class="text-accent/60 group-hover:text-accent transition-colors shrink-0 tabular-nums">
                  [{String(i + 1).padStart(2, "0")}]
                </span>
                <span>{p}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ─── WRITING ───────────────────────────────────────────────────── -->
    <section class="py-14 md:py-20 relative z-10 px-4 md:px-8 border-t border-white/[0.08]">
      <div class="max-w-[1400px] mx-auto">
        <div class="flex items-center gap-4 mb-8 md:mb-12">
          <span class="font-mono text-[9px] text-accent tracking-[0.3em] uppercase">/* 03 writing */</span>
          <div class="flex-1 h-px bg-white/[0.1]"></div>
        </div>
        <div class="flex flex-col">
          {allArticles.map((article) => (
            <a
              href={article.link}
              target="_blank"
              rel="noreferrer"
              class="group -mx-3 flex flex-col md:flex-row md:items-center justify-between gap-2 md:gap-8 px-3 py-4 border-b border-white/[0.08] hover:border-white/[0.18] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.18)] hover:bg-white/[0.025] transition-all duration-300"
            >
              <h3 class="font-mono text-sm md:text-[15px] text-white/68 group-hover:text-white group-hover:translate-x-1 transition-all duration-300 tracking-tight">
                {article.title}
              </h3>
              <div class="flex items-center gap-4 shrink-0">
                <span class="font-mono text-[9px] text-white/38 group-hover:text-accent uppercase tracking-widest transition-colors duration-300">{article.displayDate}</span>
                <svg viewBox="0 0 24 24" class="w-3 h-3 text-white/30 group-hover:text-white/70 transition-all duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M7 17L17 7M17 7H7M17 7V17" />
                </svg>
              </div>
            </a>
          ))}
        </div>
        <div class="mt-7">
          <a href="https://journal.pybash.xyz/" target="_blank" rel="noreferrer"
            class="group font-mono text-[9px] uppercase tracking-[0.3em] text-white/38 hover:text-white/75 transition-colors duration-300 flex items-center gap-3">
            <span class="border-b border-white/15 group-hover:border-white/40 pb-px">All Articles</span>
            <svg viewBox="0 0 24 24" class="w-2.5 h-2.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14m-7-7l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ─── EOF / CONTACT ────────────────────────────────────────────── -->
    <footer class="pt-14 pb-10 md:pt-18 md:pb-12 relative z-10 border-t border-white/[0.08] px-4 md:px-8">
      <div class="max-w-[1400px] mx-auto">
        <h2 class="font-mono uppercase leading-[0.88] tracking-tight text-white mb-9 overflow-hidden">
          <span class="block" style="font-size: clamp(2.5rem, 5.5vw, 5.5rem);">
            <WaveReveal text="GET IN" client:visible />
          </span>
          <span class="block text-accent" style="font-size: clamp(2.5rem, 5.5vw, 5.5rem);">
            <WaveReveal text="TOUCH." delay={0.12} client:visible />
          </span>
        </h2>
        <div class="flex flex-col md:flex-row gap-2 md:gap-6 font-mono text-[9px] tracking-widest border-t border-white/[0.08] pt-7">
          <a href="mailto:hi@pybash.xyz" class="text-white/55 hover:text-white transition-colors duration-300 uppercase">hi@pybash.xyz</a>
          <a href="https://github.com/pybash1" target="_blank" rel="noreferrer" class="text-white/55 hover:text-white transition-colors duration-300 uppercase">@pybash1</a>
          <a href="https://x.com/py_bash1" target="_blank" rel="noreferrer" class="text-white/55 hover:text-white transition-colors duration-300 uppercase">@py_bash1</a>
          <a href="https://linkedin.com/in/ananjanmitra" target="_blank" rel="noreferrer" class="text-white/55 hover:text-white transition-colors duration-300 uppercase">LinkedIn</a>
          <a href="https://instagram.com/ananjan_" target="_blank" rel="noreferrer" class="text-white/55 hover:text-white transition-colors duration-300 uppercase">Instagram</a>
        </div>
        <div class="mt-10 font-mono text-[9px] uppercase tracking-[0.2em] text-white/18 flex justify-between">
          <span>Designed for Impact</span>
          <span>© 2026</span>
        </div>
      </div>
    </footer>
  </main>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    document.querySelectorAll(".project-window").forEach((el, i) => {
      gsap.to(el, {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: "power3.out",
        delay: i * 0.06,
        scrollTrigger: { trigger: el, start: "top 90%" },
      });
    });
  </script>
</Layout>
