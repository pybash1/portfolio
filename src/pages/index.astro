---
import Layout from "../layouts/Layout.astro";
import SiteHeader from "../components/SiteHeader";
import AsciiCascade from "../components/AsciiCascade";
import WaveReveal from "../components/WaveReveal";

const rssResponse = await fetch("https://journal.pybash.xyz/rss.xml");
const rssText = await rssResponse.text();
const articleMatches = [...rssText.matchAll(/<item>([\s\S]*?)<\/item>/g)];
const allArticles = articleMatches.map(match => {
  const content = match[1];
  const title = content?.match(/<title>([\s\S]*?)<\/title>/)?.[1] || "";
  const link = content?.match(/<link>([\s\S]*?)<\/link>/)?.[1]?.replace("/blog/", "/writing/") || "";
  const pubDate = content?.match(/<pubDate>([\s\S]*?)<\/pubDate>/)?.[1] || "";
  const cleanTitle = title
    .replace(/&apos;/g, "'").replace(/&quot;/g, '"')
    .replace(/&amp;/g, "&").replace(/&gt;/g, ">").replace(/&lt;/g, "<")
    .replace(/&#(\d+);/g, (_, n) => String.fromCharCode(Number(n)))
    .replace(/&minus;/g, "−");
  return {
    title: cleanTitle,
    link,
    date: new Date(pubDate),
    displayDate: new Date(pubDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  };
}).sort((a, b) => b.date.getTime() - a.date.getTime()).slice(0, 5);

const items = [
  {
    num: "01",
    name: "KORA",
    subtitle: "Astro / Go / Plasmo",
    period: "2026",
    status: "Live",
    description: "Read, save, and annotate the web — with people you trust.",
    bullets: [
      "Bookmarks, highlights, and notes with a Tiptap editor",
      "RSS reader, podcast support, and social following built in",
      "Cross-browser extension (Chrome, Firefox, Edge) via Plasmo",
    ],
    badge: undefined,
    link: "https://kora.sh",
    linkText: "View Project",
  },
  {
    num: "02",
    name: "GRASS LABS",
    subtitle: "Engineer",
    period: "2024 — Present",
    status: "Active",
    description: "Part-time engineering role building products across the stack.",
    bullets: [],
    badge: undefined,
    link: undefined,
    linkText: undefined,
  },
  {
    num: "03",
    name: "RIFT",
    subtitle: "Founding Engineer",
    period: "2024",
    status: "Past",
    description: "Creator platform empowering creators with micropayments, token-gating, and reward systems.",
    bullets: [
      "Built community engagement tools for the new creator economy",
      "Received grant from Superteam",
    ],
    badge: "Superteam Grant",
    link: undefined,
    linkText: undefined,
  },
  {
    num: "04",
    name: "HARVENCE",
    subtitle: "React Native",
    period: "2024",
    status: "Live",
    description: "Calorie tracking and nutrition lookup — before you even buy it.",
    bullets: [
      "Instant barcode scanning with full nutritional breakdown",
      "Zero-friction logging UX built around daily habit formation",
      "React Native, built for iOS and Android",
    ],
    badge: undefined,
    link: "https://harvence.pybash.xyz",
    linkText: "View Project",
  },
  {
    num: "05",
    name: "BITPLANET",
    subtitle: "Frontend Developer",
    period: "2023 — 2024",
    status: "Past",
    description: "Core web app experience for a social chat platform.",
    bullets: [
      "Implemented profile pages, notifications, and onboarding flow",
      "Built a robust multi-level autocomplete system with paginated fetching",
      "Improved Feed UI/UX and overall core chat experience",
    ],
    badge: undefined,
    link: undefined,
    linkText: undefined,
  },
  {
    num: "06",
    name: "DRIPCRAFT",
    subtitle: "Solana / React",
    period: "2024",
    status: "Live",
    description: "Solana-based NFT marketplace — burn common NFTs to earn rarer ones, with admin access built from the ground up.",
    bullets: [],
    badge: undefined,
    link: "https://dripcraft.xyz",
    linkText: "View Project",
  },
];

---

<Layout title="Portfolio — Ananjan Mitra">
  <main class="relative">
<SiteHeader client:load />

    <!-- ─── HERO ─────────────────────────────────────────────────────── -->
    <section class="min-h-screen md:h-screen grid grid-cols-1 md:grid-cols-[minmax(280px,0.78fr)_minmax(0,1.22fr)] px-4 md:px-8 pt-20 pb-10 relative z-10 overflow-hidden gap-8 md:gap-14">

      <div class="relative z-10 flex h-auto md:h-full min-h-0 flex-col justify-center md:justify-end pb-2 md:pb-24 max-w-[520px]">
        <div class="font-mono text-[9px] uppercase tracking-[0.32em] text-accent mb-5">~/identity</div>
        <h1 class="font-mono uppercase text-white leading-[0.9] tracking-tight text-[clamp(2.7rem,7vw,6.4rem)]">
          Ananjan<br />
          <span class="text-accent">Mitra</span>
        </h1>
        <p class="mt-7 max-w-[420px] font-mono text-[11px] md:text-xs leading-[2.1] text-white/65">
          Builder from Kolkata working across apps, systems, search, and interface experiments.
          I care about fast software, strange taste, and making the thing real before explaining it.
        </p>
        <div class="mt-8 grid grid-cols-[auto_1fr] gap-x-5 gap-y-2.5 font-mono text-[9px] uppercase tracking-[0.2em]">
          <span class="text-white/35">loc</span>
          <span class="text-white/70">Kolkata, India</span>
          <span class="text-white/35">mode</span>
          <span class="text-white/70">building in public, mostly quietly</span>
        </div>
      </div>

      <div class="relative min-h-0 h-[42vh] md:h-full">
        <AsciiCascade client:load />
      </div>

      <div class="absolute bottom-8 left-4 right-4 md:left-8 md:right-8 flex justify-between items-end pointer-events-none">
        <div class="font-mono text-[9px] uppercase tracking-[0.3em] text-white/25">Scroll ↓</div>
        <div class="font-mono text-[9px] text-white/20 tracking-[0.12em] hidden md:block">v2026.06 · pybash.xyz</div>
      </div>
    </section>

    <!-- ─── WORK ──────────────────────────────────────────────────────── -->
    <section class="py-14 md:py-20 relative z-10 px-4 md:px-8 border-t border-white/[0.08]">
      <div class="max-w-[1400px] mx-auto">
        <div class="flex items-center gap-4 mb-8 md:mb-12">
          <span class="font-mono text-[9px] text-accent tracking-[0.3em] uppercase">/* 01 work */</span>
          <div class="flex-1 h-px bg-white/[0.1]"></div>
        </div>
        <div class="flex flex-col gap-2">
          {items.map((item) => (
            <div
              class="project-window font-mono border border-white/[0.12] hover:border-white/[0.28] transition-colors duration-500"
              style="opacity: 0; transform: translateY(18px);"
            >
              <div class="flex items-center justify-between px-4 md:px-5 py-2.5 border-b border-white/[0.08] bg-white/[0.03]">
                <div class="flex items-center gap-3">
                  <span class="text-white/55 text-[9px]">[{item.num}]</span>
                  <span class="text-[11px] md:text-[13px] tracking-[0.1em] text-white">{item.name}</span>
                  <span class="text-[9px] text-white/58 tracking-widest hidden md:inline">— {item.subtitle}</span>
                  {item.badge && (
                    <span class="text-[8px] tracking-[0.15em] uppercase text-accent/70 border border-accent/30 px-1.5 py-0.5 hidden md:inline">{item.badge}</span>
                  )}
                </div>
                <div class="flex items-center gap-4">
                  <span class={`text-[9px] tracking-widest uppercase ${item.status === 'Live' || item.status === 'Active' ? 'text-accent' : 'text-white/62'}`}>
                    {item.status}
                  </span>
                  <span class="text-white/55 text-[9px] hidden md:inline">{item.period}</span>
                </div>
              </div>
              <div class="px-4 md:px-5 py-4 grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_10rem] gap-4 md:gap-8 md:items-start">
                <div>
                  <p class="text-[11px] leading-[2] text-white/72 max-w-[620px]">{item.description}</p>
                  {item.bullets.length > 0 && (
                    <ul class="mt-2 flex flex-col gap-0.5">
                      {item.bullets.map((b) => (
                        <li class="flex gap-3 text-[10px] leading-[1.9] text-white/48">
                          <span class="text-accent/50 shrink-0 mt-[1px]">—</span>
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                {item.link && (
                  <div class="md:justify-self-end md:pt-1">
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noreferrer"
                      class="group inline-flex h-8 items-center justify-end gap-2 text-[9px] uppercase tracking-[0.22em] text-white/65 hover:text-white transition-colors duration-300"
                    >
                      <span>{item.linkText}</span>
                      <svg viewBox="0 0 24 24" class="w-3 h-3 text-white/50 transition-all duration-300 group-hover:text-accent group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M7 17L17 7M17 7H7M17 7V17" />
                      </svg>
                    </a>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ─── PHILOSOPHY ────────────────────────────────────────────────── -->
    <section class="py-20 md:py-32 relative z-10 px-4 md:px-8 border-t border-white/[0.08]">
      <div class="max-w-[1400px] mx-auto">
        <div class="flex items-center gap-4 mb-12 md:mb-20">
          <span class="font-mono text-[9px] text-accent tracking-[0.3em] uppercase">/* 02 philosophy */</span>
          <div class="flex-1 h-px bg-white/[0.1]"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-14 md:gap-24 items-start">
          <!-- Heading + bio -->
          <div>
            <h2 class="font-mono uppercase leading-[0.88] tracking-tight overflow-hidden">
              <span class="block text-white" style="font-size: clamp(2.5rem, 5.5vw, 5.5rem);">
                <WaveReveal text="FOR NOW," client:visible />
              </span>
              <span class="block text-accent" style="font-size: clamp(2.5rem, 5.5vw, 5.5rem);">
                <WaveReveal text="AT LEAST." delay={0.12} client:visible />
              </span>
            </h2>
            <p class="font-mono text-[11px] leading-[2.3] text-white/60 mt-10 max-w-[360px]">
              I got started trying to build an OS in Python —
              too niche to find tutorials for, which turned out to be the point.
              I try to build things. Some work, some don't.
              I'm never quite satisfied when they do.
            </p>
          </div>

          <!-- Right now — plain stacked lines -->
          <div class="flex flex-col">
            {[
              ["calcutta", "online most of the time"],
              ["homelab", "repurposed i5, 12 services on WSL2"],
              ["setup", "self-hosting everything i reasonably can"],
              ["recently", "broke an obsidian plugin instead of buying an iPhone"],
              ["status", "contemplating the next thing"],
            ].map(([key, val]) => (
              <div class="grid grid-cols-[5rem_1fr] gap-4 py-3.5 border-b border-white/[0.06] font-mono group hover:bg-white/[0.02] transition-colors duration-200 -mx-2 px-2">
                <span class="text-[9px] uppercase tracking-[0.2em] text-accent/50 pt-[1px]">{key}</span>
                <span class="text-[11px] text-white/60 group-hover:text-white/80 transition-colors duration-200 leading-[1.7]">{val}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ─── WRITING ───────────────────────────────────────────────────── -->
    <section class="py-14 md:py-20 relative z-10 px-4 md:px-8 border-t border-white/[0.08]">
      <div class="max-w-[1400px] mx-auto">
        <div class="flex items-center gap-4 mb-8 md:mb-12">
          <span class="font-mono text-[9px] text-accent tracking-[0.3em] uppercase">/* 03 writing */</span>
          <div class="flex-1 h-px bg-white/[0.1]"></div>
        </div>
        <div class="flex flex-col">
          {allArticles.map((article) => (
            <a
              href={article.link}
              target="_blank"
              rel="noreferrer"
              class="group -mx-3 flex flex-col md:flex-row md:items-center justify-between gap-2 md:gap-8 px-3 py-4 border-b border-white/[0.08] hover:border-white/[0.18] hover:shadow-[inset_0_1px_0_rgba(255,255,255,0.18)] hover:bg-white/[0.025] transition-all duration-300"
            >
              <h3 class="font-mono text-sm md:text-[15px] text-white/82 group-hover:text-white group-hover:translate-x-1 transition-all duration-300 tracking-tight">
                {article.title}
              </h3>
              <div class="flex items-center gap-4 shrink-0">
                <span class="font-mono text-[9px] text-white/55 group-hover:text-accent uppercase tracking-widest transition-colors duration-300">{article.displayDate}</span>
                <svg viewBox="0 0 24 24" class="w-3 h-3 text-white/45 group-hover:text-white/80 transition-all duration-300 group-hover:rotate-45" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M7 17L17 7M17 7H7M17 7V17" />
                </svg>
              </div>
            </a>
          ))}
        </div>
        <div class="mt-7">
          <a href="https://journal.pybash.xyz/" target="_blank" rel="noreferrer"
            class="group font-mono text-[9px] uppercase tracking-[0.3em] text-white/55 hover:text-white/85 transition-colors duration-300 flex items-center gap-3">
            <span class="border-b border-white/25 group-hover:border-white/55 pb-px">All Articles</span>
            <svg viewBox="0 0 24 24" class="w-2.5 h-2.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14m-7-7l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ─── EOF / CONTACT ────────────────────────────────────────────── -->
    <footer class="pt-14 pb-10 md:pt-18 md:pb-12 relative z-10 border-t border-white/[0.08] px-4 md:px-8">
      <div class="max-w-[1400px] mx-auto">
        <h2 class="font-mono uppercase leading-[0.88] tracking-tight text-white mb-9 overflow-hidden">
          <span class="block" style="font-size: clamp(2.5rem, 5.5vw, 5.5rem);">
            <WaveReveal text="GET IN" client:visible />
          </span>
          <span class="block text-accent" style="font-size: clamp(2.5rem, 5.5vw, 5.5rem);">
            <WaveReveal text="TOUCH." delay={0.12} client:visible />
          </span>
        </h2>
        <div class="flex flex-col md:flex-row gap-2 md:gap-6 font-mono text-[9px] tracking-widest border-t border-white/[0.08] pt-7">
          <a href="mailto:hi@pybash.xyz" class="text-white/70 hover:text-white transition-colors duration-300 uppercase">hi@pybash.xyz</a>
          <a href="https://linkedin.com/in/ananjanmitra" target="_blank" rel="noreferrer" class="text-white/70 hover:text-white transition-colors duration-300 uppercase">LinkedIn</a>
        </div>
      </div>
    </footer>
  </main>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    document.querySelectorAll(".project-window").forEach((el, i) => {
      gsap.to(el, {
        opacity: 1,
        y: 0,
        duration: 0.5,
        ease: "power3.out",
        delay: i * 0.06,
        scrollTrigger: { trigger: el, start: "top 90%" },
      });
    });
  </script>
</Layout>
