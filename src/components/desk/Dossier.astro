---
import PaperSurface from "./PaperSurface.astro";
import MetalClip from "./MetalClip.astro";
import { componentId } from "../../lib/deskGraphics";

interface Props {
  title: string;
  reference?: string;
  role: string;
  text: string;
  annotation?: string;
  class?: string;
}

const {
  title,
  reference,
  role,
  text,
  annotation,
  class: className,
} = Astro.props;

const id = componentId("dossier");
---

<article
  data-clip-surface
  class:list={["relative isolate p-3 text-[#1d100e]", className]}
>
  <PaperSurface
    seed={title}
    material="card"
    wear="sharp"
    color="#e25849"
    strength="heavy"
  />
  <div class="border border-current p-1">
    <div class="relative border border-current p-4">
      {
        reference && (
          <p class="border-b border-current/60 pb-2 font-print text-[10px] font-bold uppercase tracking-[.12em]">
            {reference}
          </p>
        )
      }
      <h2
        class="my-4 whitespace-pre-line font-sans text-[30px] leading-[.95] tracking-tight"
      >
        {title}
      </h2>
      <div class="flow-root border-y border-current/70 py-3">
        <img
          src="/photos/dossier-portrait.png"
          alt="Ink portrait of Ananjan Mitra"
          width="1122"
          height="1402"
          class="relative -top-1.5 float-left mr-3 mb-2 h-25 w-20 scale-105 object-contain"
        />
        <p class="font-print text-[15px] font-bold leading-snug">{role}</p>
        <p class="mt-3 font-mono text-[10px] font-medium leading-[1.35]">
          {text}
        </p>
      </div>
      {
        annotation && (
          <p class="mt-3 -rotate-3 text-right font-hand text-[21px]">
            {annotation}
          </p>
        )
      }
      <span
        aria-hidden="true"
        class="absolute -left-2 top-1/2 size-2 rounded-full bg-current"></span>
    </div>
  </div>
  <MetalClip
    id={`${id}-clip`}
    kind="paperclip"
    color="yellow"
    class="absolute right-3 -top-[19px] z-40 w-12"
  />
</article>
