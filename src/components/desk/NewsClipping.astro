---
import Grain from "./Grain.astro";
import PaperCrease from "./PaperCrease.astro";
import RayShadow from "./RayShadow.astro";
import { componentId } from "../../lib/deskGraphics";
import { tornSheet } from "../../lib/paperWear";

/** An old newspaper cutting: yellowed newsprint with a headline, justified
 * columns and a halftone picture, torn from the page by hand on
 * three sides (a pale fibrous rim where the print peeled away) and cut
 * straight with scissors on the fourth. A fold runs across it. */
interface Props {
  /** One entry per line: each line is set to the full column width. */
  headline: string | string[];
  byline: string;
  /** Column text; one paragraph per entry, flowing across two columns. */
  paragraphs?: string[];
  /** Under the halftone picture. */
  caption: string;
  class?: string;
}

const {
  headline: headlineProp,
  byline,
  paragraphs = [],
  caption,
  class: className,
} = Astro.props;

const lines = [headlineProp].flat();
const headline = lines.join(" ");
const shadow = componentId("clipping-shadow");
const { outer, inner, outline } = tornSheet(headline);
const mask = (image: string) => ({
  maskImage: image,
  maskSize: "100% 100%",
  maskRepeat: "no-repeat",
});
---

<article
  data-clip-surface
  aria-label={`Newspaper cutting: ${headline}`}
  class:list={[
    "relative isolate aspect-[4/5.2] text-[#2b261c] [container-type:inline-size]",
    className,
  ]}
>
  <span
    data-paper-backing
    data-ray-caster={shadow}
    aria-hidden="true"
    style={`filter:url(#${shadow})`}
    class="pointer-events-none absolute inset-0 -z-10"
  >
    <!-- The torn core: paler, fibrous, a little wider than the print. -->
    <span class="absolute inset-0 bg-[#f2ead3]" style={mask(outer)}>
      <Grain
        material="kraft"
        strength="light"
        seed={`${headline}:core`}
        creases={false}
      />
    </span>
    <!-- The newsprint face, stained with age toward its edges. -->
    <span class="absolute inset-0 bg-[#d9cca4]" style={mask(inner)}>
      <span
        class="absolute inset-0 bg-[radial-gradient(ellipse_at_0%_0%,#8a6a2a55,transparent_55%),radial-gradient(ellipse_at_100%_100%,#7a5a2260,transparent_50%),radial-gradient(circle_at_72%_18%,#8a5a2040,transparent_9%),radial-gradient(circle_at_14%_71%,#8a5a2038,transparent_7%),radial-gradient(circle_at_58%_88%,#8a5a2030,transparent_5%)]"
      ></span>
      <Grain
        material="cotton"
        strength="heavy"
        seed={headline}
        creases={false}
      />
    </span>
  </span>
  <RayShadow id={shadow} height={5} />
  <!-- Clips seat on the torn edge, not the box around it (paperClips.ts). -->
  <svg
    aria-hidden="true"
    viewBox="0 0 1000 1000"
    preserveAspectRatio="none"
    class="pointer-events-none invisible absolute inset-0 size-full"
  >
    <polygon data-clip-outline points={outline}></polygon>
  </svg>

  <div
    class="absolute inset-[9%] flex flex-col mix-blend-multiply [text-rendering:geometricPrecision]"
  >
    <h2
      class="font-sans text-[10.5cqw] font-bold uppercase leading-[0.95] tracking-tight"
    >
      {
        lines.map((line) => (
          <span data-fit-line class="block whitespace-nowrap">
            <span class="inline-block">{line}</span>
          </span>
        ))
      }
    </h2>
    <p class="mt-[1.6cqw] font-print text-[2.6cqw] uppercase tracking-widest">
      {byline}
    </p>

    <div
      data-column-flow
      class="relative mt-[2.4cqw] min-h-0 flex-1 columns-3 [column-fill:auto] gap-[3cqw] overflow-hidden text-left font-book text-[3.1cqw] leading-[1.32] [column-rule:1px_solid_#2b261c40] [hyphens:auto]"
      lang="en"
    >
      {
        paragraphs.map((p, i) => (
          <p
            class:list={[
              "indent-[2.6cqw]",
              i === 0 &&
                "first-letter:float-left first-letter:mr-[0.6cqw] first-letter:font-sans first-letter:text-[11cqw] first-letter:font-bold first-letter:leading-[0.8] first-letter:indent-0",
            ]}
          >
            {p}
          </p>
        ))
      }
      <!-- Pinned over the top of the last column; the script below pushes
           that column's text down beneath it. -->
      <figure
        data-column-photo
        class="absolute right-0 top-0 w-[calc((100%-6cqw)/3)]"
      >
        <div class="relative aspect-4/5 overflow-hidden bg-[#c9bb92]">
          <img
            src="/photos/headshot-mini.webp"
            alt="Ananjan sitting in front of library shelves, arms crossed"
            width="1568"
            height="1456"
            loading="lazy"
            draggable="false"
            class="absolute inset-0 size-full object-cover object-[50%_30%] [filter:grayscale(1)_sepia(0.7)_contrast(1.25)_brightness(0.9)_blur(0.3px)]"
          />
          <span
            aria-hidden="true"
            class="absolute inset-0 bg-[radial-gradient(circle,transparent_0_40%,#d9cca4_44%)] bg-[length:0.8cqw_0.8cqw] opacity-35"
          ></span>
        </div>
        <figcaption
          class="mt-[1cqw] font-print text-[2.4cqw] italic leading-tight"
        >
          {caption}
        </figcaption>
      </figure>
    </div>
  </div>

  <PaperCrease seed={headline} axis="horizontal" position={56} />
</article>

<script>
  // Set every headline line to the full width of its column, as a
  // compositor would: each line gets the size that makes it exactly fit.
  // Sizes are in cqw, so they follow the clipping when it is resized.
  const fit = () => {
    document
      .querySelectorAll<HTMLElement>("[data-fit-line]")
      .forEach((line) => {
        const text = line.firstElementChild as HTMLElement;
        const card = line.closest<HTMLElement>("article")!;
        const measured = 100;

        line.style.fontSize = `${measured}px`;
        const size = (measured * line.clientWidth) / text.offsetWidth;
        line.style.fontSize = `${(size / card.clientWidth) * 100}cqw`;
      });
  };

  // Start the last column below the photo pinned over its top: find the
  // first word set in that column and put a photo-tall spacer before it.
  // The clipping may be rotated, so positions are measured along the
  // flow's own x axis, taken from two probes at its top corners.
  const wrapPhoto = () => {
    document
      .querySelectorAll<HTMLElement>("[data-column-flow]")
      .forEach((flow) => {
        const photo = flow.querySelector<HTMLElement>("[data-column-photo]")!;
        const card = flow.closest<HTMLElement>("article")!;
        flow.querySelector("[data-photo-spacer]")?.remove();

        const probe = (left: string) => {
          const el = document.createElement("span");
          el.style.cssText = `position:absolute;top:0;left:${left};width:0;height:0`;
          flow.append(el);
          const { left: x, top: y } = el.getBoundingClientRect();
          el.remove();
          return { x, y };
        };
        const origin = probe("0");
        const end = probe("100%");
        const ax = end.x - origin.x;
        const ay = end.y - origin.y;
        const scale = Math.hypot(ax, ay) / flow.clientWidth;
        if (!scale) return;
        const localX = (r: DOMRect) =>
          ((r.left + r.width / 2 - origin.x) * ax +
            (r.top + r.height / 2 - origin.y) * ay) /
          Math.hypot(ax, ay) /
          scale;

        const walker = document.createTreeWalker(flow, NodeFilter.SHOW_TEXT);
        const range = document.createRange();
        for (let node; (node = walker.nextNode() as Text | null); ) {
          if (photo.contains(node)) continue;
          for (let i = 0; i < node.length; i++) {
            if (/\s/.test(node.data[i])) continue;
            range.setStart(node, i);
            range.setEnd(node, i + 1);
            if (localX(range.getBoundingClientRect()) < photo.offsetLeft)
              continue;

            // Move the whole word down, not just its hyphenated tail.
            while (i > 0 && !/\s/.test(node.data[i - 1])) i--;
            const spacer = document.createElement("span");
            spacer.dataset.photoSpacer = "";
            spacer.style.display = "block";
            spacer.style.breakBefore = "column";
            spacer.style.height = `${((photo.offsetHeight / card.clientWidth) * 100 + 2.5).toFixed(2)}cqw`;
            const para = node.parentElement!;
            if (i === 0 && node === para.firstChild) para.before(spacer);
            else {
              range.setStart(node, i);
              range.collapse(true);
              range.insertNode(spacer);
            }
            return;
          }
        }
      });
  };

  document.fonts.ready.then(() => {
    fit();
    wrapPhoto();
  });
</script>
