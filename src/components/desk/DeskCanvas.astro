---
interface Props {
  storageKey: string;
  label?: string;
  class?: string;
}

const {
  storageKey,
  label = "Movable collection",
  class: className,
} = Astro.props;
---

<main
  data-desk-canvas
  data-storage-key={`desk-layout:${storageKey}`}
  aria-label={label}
  class:list={["relative isolate", className]}
>
  <slot />
  <button
    type="button"
    data-desk-reset
    aria-label="Reset object arrangement"
    title="Reset arrangement"
    class="absolute bottom-4 right-4 z-[2147483647] flex size-9 cursor-pointer items-center justify-center rounded-full border border-paper/10 bg-black/70 text-paper/40 outline-offset-4 hover:border-paper/30 hover:text-paper focus-visible:outline-2 focus-visible:outline-paper"
  >
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      class="size-4"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M4 10a8 8 0 1 1 1 7M4 4v6h6"></path>
    </svg>
  </button>
  <span data-desk-announcement aria-live="polite" class="sr-only"></span>
</main>
<script>
  import { initializeDesk } from "../../lib/movableDesk";
  import { initializePaperClips } from "../../lib/paperClips";
  import { initializeMagnets } from "../../lib/deskMagnets";
  import { initializeTurnover } from "../../lib/deskTurnover";
  import { initializeFolderClose } from "../../lib/folderClose";
  import { initializeJumperWires } from "../../lib/jumperWires";
  import { initializeJournalPocket } from "../../lib/journalPocket";
  import { initializeDeskFocus } from "../../lib/deskFocus";
  import { initializeFolderSheets } from "../../lib/folderSheets";
  import { initializeBumps } from "../../lib/deskBumps";
  import { aimRayShadowsWithin, refreshRayShadows } from "../../lib/rayShadow";

  document
    .querySelectorAll<HTMLElement>("[data-desk-canvas]")
    .forEach((canvas) => {
      initializePaperClips(canvas);
      initializeMagnets(canvas);
      initializeDesk(canvas);
      initializeFolderClose(canvas);
      initializeTurnover(canvas);
      initializeBumps(canvas);
      initializeJumperWires(canvas);
      initializeJournalPocket(canvas);
      initializeFolderSheets(canvas);
      initializeDeskFocus(canvas);

      // Aim every shadow from the one desk light. Rotations change only with
      // layout breakpoints, so re-aim on resize rather than every frame.
      let frame = requestAnimationFrame(() => refreshRayShadows(canvas));

      window.addEventListener("resize", () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => refreshRayShadows(canvas));
      });

      // Hardware riding on a folder leaf or the map comes to rest facing a new way.
      canvas.addEventListener("desk:folder-toggle", () =>
        refreshRayShadows(canvas),
      );

      canvas.addEventListener("desk:settled", () => refreshRayShadows(canvas));

      // While a leaf or the map turns, aim only what rides on it, from its real 3D tilt.
      canvas.addEventListener("desk:turning", (event) => {
        if (event.target instanceof Element)
          aimRayShadowsWithin(event.target, true);
      });
    });
</script>
