---
import "../styles/globals.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class="min-h-full overflow-x-clip bg-[#111] font-sans text-white antialiased select-none"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link
      rel="preload"
      href="/fonts/balete-variablevf.woff"
      as="font"
      type="font/woff"
      crossorigin
    />
    <slot name="head" />
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <slot />
    <script is:inline>
      (() => {
        const serial = document.querySelector("[data-ticket-serial]");
        const showCount = (count) => {
          if (serial && Number.isSafeInteger(count) && count >= 0)
            serial.textContent = `NO. ${String(count).padStart(6, "0")}`;
        };

        try {
          const cached = localStorage.getItem("portfolio-visitor-count");
          if (cached !== null) showCount(Number(cached));
        } catch {
          // The ticket still has its numeric fallback.
        }

        window.addEventListener(
          "load",
          () => {
            void fetch("/api/visitor-count", {
              method: "POST",
              cache: "no-store",
            })
              .then((response) => (response.ok ? response.json() : null))
              .then((result) => {
                if (!Number.isSafeInteger(result?.count) || result.count < 0)
                  return;
                showCount(result.count);
                try {
                  localStorage.setItem(
                    "portfolio-visitor-count",
                    String(result.count),
                  );
                } catch {
                  // Browser storage is optional.
                }
              })
              .catch(() => {});
          },
          { once: true },
        );
      })();
    </script>
  </body>
</html>
